# Dependencies and build output — never needed in build context
node_modules
.next
build

# Git and editor metadata
.git
.gitignore
.DS_Store

# Environment files — secrets must not enter the build context
.env*

# Logs
npm-debug.log*
*.log

# Dev/CI artefacts
coverage

# Project-specific directories not needed for the image.
# NOTE: Docker cannot reliably re-include a file inside an excluded
# *directory*, so scripts/ excludes its contents and re-includes the two
# files the deploy image needs (the migration runner and its splitter).
docs/
scripts/*
!scripts/migrate.mjs
!scripts/sql-split.mjs
audit/
.claude/

# Large data files — but the versioned migrations must reach the image so
# the pre-deployment command can run them.
*.sql
!migrations/*.sql

# Docker files themselves
Dockerfile
.dockerignore

# OS/editor noise
*.md
